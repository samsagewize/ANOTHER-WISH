rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidInscription(data) {
      return data.wish is string && data.wish.size() <= 1000 &&
             data.contentType is string &&
             data.wishTxid is string &&
             (data.regTxid == null || data.regTxid is string) &&
             data.address is string &&
             data.timestamp is number &&
             data.feeRate is number &&
             data.status is string &&
             data.creatorUid is string &&
             (!('serviceFee' in data) || data.serviceFee is number) &&
             (!('registered' in data) || data.registered is bool);
    }

    function isValidProfile(data, profileId) {
      return data.address == profileId &&
             data.address is string &&
             data.displayName is string &&
             data.displayName.size() <= 40 &&
             data.avatarUrl is string &&
             data.avatarUrl.size() <= 500 &&
             data.twitterUrl is string &&
             data.twitterUrl.size() <= 120 &&
             data.bio is string &&
             data.bio.size() <= 240 &&
             data.verifiedAt is number &&
             data.updatedAt is number;
    }

    function isValidMessage(data) {
      return data.address is string &&
             data.text is string &&
             data.text.size() > 0 &&
             data.text.size() <= 280 &&
             data.timestamp is number;
    }

    match /inscriptions/{inscriptionId} {
      allow read: if true;
      allow create: if isValidInscription(request.resource.data);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    match /profiles/{profileId} {
      allow read: if true;
      allow create, update: if isValidProfile(request.resource.data, profileId);
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow read: if true;
      allow create: if isValidMessage(request.resource.data);
      allow update, delete: if false;
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
